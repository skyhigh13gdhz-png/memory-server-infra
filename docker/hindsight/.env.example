# 复制为 .env 后在服务器本地填写。真实 .env 不得提交 Git。

# 默认使用 Full 镜像。低磁盘/低内存机器后续可评估 slim，但 slim 需要额外配置 embeddings/reranker provider。
HINDSIGHT_IMAGE_TAG=latest

# LLM Provider 示例。按你实际使用的供应商修改。
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-5-mini
HINDSIGHT_API_LLM_API_KEY=

# 小服务器默认降低并发；高配服务器可在实测后调高。
HINDSIGHT_API_LLM_MAX_CONCURRENT=2
HINDSIGHT_API_WORKER_ID=memory-server-main

# network_mode: host 下，容器可访问宿主机仅监听 127.0.0.1 的 Xray。
HINDSIGHT_HTTP_PROXY=http://127.0.0.1:10809
HINDSIGHT_NO_PROXY=localhost,127.0.0.1,::1
