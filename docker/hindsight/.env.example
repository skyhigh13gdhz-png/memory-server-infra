# 复制为 .env 后保存在服务器本地。真实 .env / OAuth 凭据不得提交 Git。

# 默认使用 Full 镜像。低磁盘/低内存机器后续可评估 slim。
HINDSIGHT_IMAGE_TAG=latest

# 默认复用 ChatGPT 的 Codex OAuth，不需要 OpenAI Platform API Key。
# 模型仍是显式配置项，不依赖 ChatGPT 客户端的“自动选模型”。
# 默认选择 GPT-5.6 Terra：在 Codex 中覆盖面较广，并兼顾能力、速度与资源消耗。
# 可按账号权限改为其他当前可用模型；部署/健康检查应实际请求验证，而不是假定模型名永久有效。
HINDSIGHT_API_LLM_PROVIDER=openai-codex
HINDSIGHT_API_LLM_MODEL=gpt-5.6-terra
HINDSIGHT_API_LLM_API_KEY=

# 给长期运行的 Hindsight 单独隔离 Codex OAuth，避免与其他 Codex 进程共享/轮换 refresh token。
CODEX_HOME=/var/lib/hindsight/codex

# 小服务器默认降低并发；高配服务器可在实测后调高。
HINDSIGHT_API_LLM_MAX_CONCURRENT=2
HINDSIGHT_API_WORKER_ID=memory-server-main

# network_mode: host 下，容器可访问宿主机仅监听 127.0.0.1 的 Xray。
# 注意：Codex provider 当前 aiohttp 不读取这些环境代理；其出站由 Hindsight scoped transparent proxy 接管。
HINDSIGHT_HTTP_PROXY=http://127.0.0.1:10809
HINDSIGHT_NO_PROXY=localhost,127.0.0.1,::1
